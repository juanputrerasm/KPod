<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.0.0.0</Version>
    <Company>MTMG</Company>
    <Product>KPod</Product>
    <Authors>Kmaster</Authors>
    <Description>Terminal Reality POD archive utility for Windows</Description>
    <Copyright>(c)2026 Juan Pablo Utreras "Kmaster"</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- .NET Framework reference assemblies carry no nullable annotations, so
         full checking here reports false positives on every BCL call. Keep the
         annotations, drop the warnings; the .NET leg does the real checking. -->
    <Nullable>annotations</Nullable>
  </PropertyGroup>

</Project>
