<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <RootNamespace>KPod.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KPod.Core\KPod.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Compile Include="..\KPod.Core\Compat\IsExternalInit.cs" Link="Compat\IsExternalInit.cs" />
    <Compile Include="..\KPod.Core\Compat\Polyfills.cs" Link="Compat\Polyfills.cs" />
    <Compile Include="..\KPod.Core\Compat\FrameworkExtensions.cs" Link="Compat\FrameworkExtensions.cs" />
    <Using Include="KPod.Core.Compat" />
  </ItemGroup>

</Project>
