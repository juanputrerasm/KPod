<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <RootNamespace>KPod.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The MTM1 default palette, used when a RAW file has no ACT of its own. -->
    <EmbeddedResource Include="Assets\metalcr2.act" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Framework-only extension methods, in scope everywhere on this leg. -->
    <Using Include="KPod.Core.Compat" />
  </ItemGroup>

</Project>
