<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Condition="'$(TargetFramework)' != 'net48'">
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- DPI awareness comes from the manifest on .NET Framework. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- No app.config needed; the manifest carries everything. -->
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <!-- Compile the app's IL to native ahead of time so starting it does not have to
       JIT its own code first. Publish only, and only with a runtime identifier,
       which is what crossgen needs to know what to compile for. The .NET Framework
       leg has no equivalent short of NGen, which needs an installer. -->
  <PropertyGroup Condition="'$(TargetFramework)' != 'net48' And '$(RuntimeIdentifier)' != ''">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!-- ReadyToRun is a .NET Core feature and does nothing for .NET Framework, but
       asking for it still has an effect: with no RuntimeIdentifier given, the SDK
       sets one from the machine doing the build (see UseCurrentRuntimeIdentifier in
       Microsoft.NET.RuntimeIdentifierInference.targets). Publishing net48 from a Mac
       then quietly emits an ARM64 binary that no Windows PC will run. Fail loudly
       instead. -->
  <Target Name="RejectReadyToRunOnNetFramework" BeforeTargets="PrepareForBuild"
          Condition="'$(TargetFramework)' == 'net48' And '$(PublishReadyToRun)' == 'true'">
    <Error Text="PublishReadyToRun does nothing for the net48 build and makes the SDK infer a runtime identifier from this machine, producing a binary for the wrong architecture. Drop -p:PublishReadyToRun=true from the net48 publish; the net48 output is x86 and runs on every 32-bit and 64-bit Windows. The .NET 10 publish enables ReadyToRun on its own." />
  </Target>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows;net48</TargetFrameworks>
    <RootNamespace>KPod.Windows</RootNamespace>
    <AssemblyName>KPod</AssemblyName>
    <!-- What Windows shows as "File description" in a file's Details tab, and what
         Task Manager lists a running process under. It comes from AssemblyTitle, not
         from Description: that one becomes the Comments field. Without this it would
         default to the assembly name and just repeat "KPod". -->
    <AssemblyTitle>POD authoring tool</AssemblyTitle>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\KPod.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 32-bit, because the optional MOD playback add-on is the 32-bit libopenmpt and a
         64-bit process cannot load it. An AnyCPU net48 build would silently run as x64
         on every modern PC and never find a usable libopenmpt. -->
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Costura.Fody" Version="6.2.0" PrivateAssets="all"
                      Condition="'$(TargetFramework)' == 'net48'" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <ProjectReference Include="..\KPod.Core\KPod.Core.csproj" />
  </ItemGroup>

  <!-- .NET Framework has no single-file publish, so the core sources are
       compiled straight into the executable instead. One file, no merge tool. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Compile Include="..\KPod.Core\**\*.cs"
             Exclude="..\KPod.Core\bin\**\*.cs;..\KPod.Core\obj\**\*.cs"
             Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\KPod.Core\Assets\metalcr2.act"
                      LogicalName="KPod.Core.Assets.metalcr2.act" />
  </ItemGroup>

  <ItemGroup>
    <!-- ApplicationIcon covers Explorer and the taskbar; forms need the icon at
         runtime, so it is embedded as well. -->
    <EmbeddedResource Include="Assets\KPod.ico" />
    <!-- Notices for what is actually inside the exe. libopenmpt and its codecs are an
         optional add-on now, so their licenses ship in mod-playback/ beside the DLLs
         instead of adding 60 KB to every download. -->
    <EmbeddedResource Include="Assets\Licenses\ThirdPartyNotices.txt"
                      LogicalName="KPod.Windows.Licenses.ThirdPartyNotices.txt" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Using Include="KPod.Core.Compat" />
  </ItemGroup>

</Project>
